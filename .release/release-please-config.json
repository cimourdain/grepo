{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "grepo",
      "changelog-sections": [
        { "type": "feat", "section": ":rocket: Features", "hidden": false },
        { "type": "fix", "section": ":bug: Bug Fixes", "hidden": false },
        { "type": "perf", "section": ":zap: Performance", "hidden": false },
        { "type": "revert", "section": ":rewind: Reverts", "hidden": false },
        { "type": "refactor", "section": ":recycle: Refactoring", "hidden": false },
        { "type": "docs", "section": ":memo: Documentation", "hidden": false },
        { "type": "test", "section": ":white_check_mark: Tests", "hidden": false },
        { "type": "build", "section": ":package: Build", "hidden": false },
        { "type": "ci", "section": ":construction_worker: CI", "hidden": false },
        { "type": "chore", "section": ":wrench: Chores", "hidden": true },
        { "type": "style", "section": ":art: Style", "hidden": true }
      ]
    }
  }
}

{
  "name": "grepo",
  "desktopName": "grepo.desktop",
  "version": "0.1.0",
  "description": "Desktop app to manage the local repositories of a workspace: browse, filter, and open them on GitHub, CircleCI and VS Code.",
  "main": "./out/main/index.js",
  "author": "",
  "private": true,
  "license": "ISC",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "postinstall": "install-electron",
    "format": "prettier --write .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run",
    "lint": "eslint . --fix && pnpm lint:md",
    "lint:md": "markdownlint-cli2",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "pnpm typecheck && electron-vite build && electron-builder --dir",
    "build:linux": "pnpm typecheck && electron-vite build && electron-builder --linux --publish never",
    "build:win": "pnpm typecheck && electron-vite build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.1",
    "electron": "^45.3.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "happy-dom": "^14.12.3",
    "markdownlint-cli2": "^0.24.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.9",
    "vue": "^3.5.43",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^3.0.0",
    "vue-router": "^4.6.4"
  }
}
